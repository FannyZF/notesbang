# ---- backend ----
ENVIRONMENT=development
# SQLite (zero-infra local). Postgres example below:
# DATABASE_URL=postgresql+psycopg://spekernotes:spekernotes_dev@localhost:5432/spekernotes
DATABASE_URL=sqlite:///./spekernotes.db

# console prints verification links to stdout (dev direct-through).
MAIL_DRIVER=console
APP_BASE_URL=http://localhost:8000

# Product knobs (PRD §17 placeholders)
PAGE_LIMIT=80
TRIAL_PAGES_LIMIT=2
PRICE_PER_PAGE_POINTS=1
EXPORT_ENABLED=false

# ---- LLM (Phase 1) ----
# mock = offline deterministic provider (default). deepseek = real API.
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
COST_INPUT_PER_M=0.27
COST_OUTPUT_PER_M=1.10

# ---- length / speech defaults (PRD §4.4 placeholders) ----
DEFAULT_SPEED_CPS_CN=3.3
DEFAULT_SPEED_CPS_EN=2.5
PACING_FACTOR=0.85
CHAR_TOLERANCE=0.15

# ---- Phase 2 async execution ----
# true => generate/regen enqueue on an in-process thread pool (client polls
# /jobs); false => run inline (tests / simple local dev). Celery can layer on.
EXEC_ASYNC=false
ASYNC_MAX_WORKERS=2

# ---- frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# ---- secrets: never commit real values; inject via your secret manager ----
# DEEPSEEK_API_KEY=
# SMTP_HOST= smtp host e.g. smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# MAIL_DRIVER=smtp   # console prints links to stdout (dev)
# ADMIN_TOKEN=       # protects /api/admin/* and the /admin console
# OBJECT_STORAGE_*=
