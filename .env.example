# ---- backend ----
ENVIRONMENT=development
# SQLite (zero-infra local). Postgres example below:
# DATABASE_URL=postgresql+psycopg://spekernotes:spekernotes_dev@localhost:5432/spekernotes
DATABASE_URL=sqlite:///./spekernotes.db

# console prints verification links to stdout (dev direct-through).
MAIL_DRIVER=console
# Origin used to build links inside emails. /verify and /reset are FRONTEND
# pages, so this must be the public site origin (not the API, not .../api).
# Local default is the web port: http://localhost:3000
# (When running the Docker stack this is derived from PUBLIC_ORIGIN below.)
APP_BASE_URL=https://your-domain.example

# ---- Deployment (docker compose) ----
# Public origin users visit. Include the port when non-standard.
# Examples: http://203.0.113.10:8088  |  https://notesbang.example.com
PUBLIC_ORIGIN=http://localhost:8088
# Host port Caddy listens on (maps to container :80).
HTTP_PORT=8088
# Host port for HTTPS (only used when SITE_ADDRESS is a real domain).
HTTPS_PORT=443
# Caddy site address. ":80" = plain HTTP for any host (IP:PORT access).
# Set to your domain (e.g. notesbang.example.com) for automatic HTTPS.
SITE_ADDRESS=:80
# Contact email for Let's Encrypt certificate expiry notices.
ACME_EMAIL=yueng@qq.com

# Postgres credentials used by docker compose (change for production).
POSTGRES_USER=notesbang
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=notesbang

# Container images. GitHub Actions publishes these to GHCR on every push;
# `docker compose pull` fetches them. Use `--build` to build locally instead.
IMAGE_PREFIX=ghcr.io/fannyzf
IMAGE_TAG=latest

# Product knobs (PRD §17 placeholders)
PAGE_LIMIT=80
TRIAL_PAGES_LIMIT=2
PRICE_PER_PAGE_POINTS=1
EXPORT_ENABLED=false

# ---- LLM (Phase 1) ----
# mock = offline deterministic provider (default). deepseek = real API.
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
COST_INPUT_PER_M=0.27
COST_OUTPUT_PER_M=1.10

# ---- length / speech defaults (PRD §4.4 placeholders) ----
DEFAULT_SPEED_CPS_CN=3.3
DEFAULT_SPEED_CPS_EN=2.5
PACING_FACTOR=0.85
CHAR_TOLERANCE=0.15

# ---- Phase 2 async execution ----
# thread (dev) or celery (Redis broker, production).
TASK_BACKEND=thread
EXEC_ASYNC=false
ASYNC_MAX_WORKERS=2
REDIS_URL=
CELERY_EAGER=false

# ---- Object storage (optional; unused by the content-scoring product) ----
STORAGE_BACKEND=local          # local | s3 (the Docker stack uses local)
STORAGE_DIR=storage
S3_ENDPOINT=
S3_BUCKET=notesbang
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_SECURE=false

# ---- Slide rendering + vision (unused; kept for compatibility) ----
RENDER_SLIDES=false
SOFFICE_PATH=
VISION_ENABLED=false
VISION_MAX_PAGES=20

# ---- Content scoring product ----
CONTENT_MAX_CHARS=3000
FREE_DAILY_LIMIT=3
# Frontend copy mirrors (must match the two values above; used at build time)
NEXT_PUBLIC_MAX_CONTENT_CHARS=3000
NEXT_PUBLIC_FREE_DAILY_LIMIT=3
RUBRIC_VERSION=v2
SCORING_CACHE_ENABLED=true
# LLM rewrite auditor (report-only). Toggle at runtime from /admin.
AUDIT_LLM_ENABLED=true
# Salt for anonymous traffic stats (visitor hashes = hash(salt+month+IP+UA)).
TRACK_SALT=change-me

# ---- Retention / GDPR ----
RETENTION_DAYS=30

# ---- Observability ----
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES=0.1

# ---- Payments ----
PAYMENT_PROVIDER=mock          # mock | fastspring
FASTSPRING_API_KEY=
FASTSPRING_STORE_ID=
FASTSPRING_WEBHOOK_SECRET=

# ---- frontend ----
# Local (non-Docker) dev only; the Docker build derives this from PUBLIC_ORIGIN.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# ---- secrets: never commit real values; inject via your secret manager ----
# DEEPSEEK_API_KEY=
# SMTP_HOST= smtp host e.g. smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# MAIL_DRIVER=smtp   # console prints links to stdout (dev)
# ADMIN_TOKEN=       # protects /api/admin/* and the /admin console
# PUBLIC_WEB_URL=https://your-domain   # non-Docker runs; Docker uses PUBLIC_ORIGIN
